# ==============================================================================
# White-Label Multi-Tenant Restaurant Platform - Environment Configuration
# ==============================================================================

# Core
NODE_ENV=development
APP_ENV=local
PORT=4000

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/food_platform?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/food_platform?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth Secrets
JWT_ACCESS_SECRET=local-dev-jwt-access-secret-minimum-32-chars-key
REFRESH_TOKEN_PEPPER=local-dev-refresh-token-pepper-32-chars-key

# Application URLs
PUBLIC_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001
PLATFORM_APP_URL=http://localhost:3002
API_BASE_URL=http://localhost:4000

# Object Storage (S3 / Local Mock)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=food-platform-assets
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Communication Providers
EMAIL_PROVIDER=mock
EMAIL_FROM=noreply@foodplatform.local
SMS_PROVIDER=mock

# Payment Providers
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=local-mock-webhook-secret

# Observability (Optional for local dev)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
