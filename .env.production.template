# Environment Variables Reference
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.prod and fill in real values.
# NEVER commit .env.prod to source control.
# Use a secrets manager (e.g. AWS Secrets Manager, Vault, 1Password) for
# production secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Pooled connection (PgBouncer / Supabase pooler / Railway)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?pgbouncer=true&connection_limit=5
# Direct connection (used by Prisma Migrate)
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:PASSWORD@HOST:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_HEX
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_ME

# ── Firebase Cloud Messaging (push notifications) ─────────────────────────────
# Full JSON of your Firebase service account (base64-encoded recommended)
FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── Storage (S3-compatible) ───────────────────────────────────────────────────
STORAGE_BUCKET=your-bucket-name
STORAGE_REGION=us-east-1
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME

# ── App URL ───────────────────────────────────────────────────────────────────
APP_URL=https://api.yourrestaurant.com
CUSTOMER_WEB_URL=https://yourrestaurant.com
OPS_WEB_URL=https://ops.yourrestaurant.com

# ── Postgres Docker (only if using docker-compose.prod.yml) ──────────────────
POSTGRES_USER=restaurant
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=restaurant_prod
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
