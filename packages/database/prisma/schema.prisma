datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis()]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CLOSED
}

model Tenant {
  id               String       @id @default(uuid()) @db.Uuid
  name             String       @db.VarChar
  slug             String       @unique @db.VarChar
  status           TenantStatus
  default_currency String       @db.Char(3)
  default_locale   String       @db.VarChar
  timezone         String       @db.VarChar
  created_at       DateTime     @default(now()) @db.Timestamptz
  updated_at       DateTime     @updatedAt @db.Timestamptz

  domains          TenantDomain[]
  settings         TenantSettings?
  features         TenantFeature[]
  branches         Branch[]
  memberships      TenantMembership[]
  roles            Role[]
  customers        Customer[]
  refresh_sessions RefreshSession[]
  otp_challenges   OtpChallenge[]
  categories       Category[]
  products         Product[]
  modifier_groups  ModifierGroup[]
  idempotency_keys IdempotencyKey[]
  audit_logs       AuditLog[]

  @@map("tenants")
}

enum DomainType {
  SUBDOMAIN
  CUSTOM
}

enum DomainStatus {
  PENDING
  VERIFIED
  FAILED
}

model TenantDomain {
  id                      String       @id @default(uuid()) @db.Uuid
  tenant_id               String       @db.Uuid
  hostname                String       @db.VarChar
  type                    DomainType
  status                  DomainStatus
  is_primary              Boolean
  verification_token_hash String?      @db.VarChar
  verified_at             DateTime?    @db.Timestamptz
  created_at              DateTime     @default(now()) @db.Timestamptz
  updated_at              DateTime     @updatedAt @db.Timestamptz

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([hostname])
  @@map("tenant_domains")
}

model TenantSettings {
  tenant_id               String   @id @db.Uuid
  restaurant_display_name String   @db.VarChar
  support_phone           String?  @db.VarChar
  support_email           String?  @db.VarChar
  order_prefix            String   @db.VarChar
  logo_media_id           String?  @db.Uuid
  theme_json              Json     @db.JsonB
  checkout_json           Json     @db.JsonB
  notification_json       Json     @db.JsonB
  seo_json                Json     @db.JsonB
  updated_at              DateTime @updatedAt @db.Timestamptz

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model TenantFeature {
  tenant_id   String   @db.Uuid
  feature_key String   @db.VarChar
  enabled     Boolean
  config_json Json?    @db.JsonB
  updated_at  DateTime @updatedAt @db.Timestamptz

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@id([tenant_id, feature_key])
  @@map("tenant_features")
}

enum BranchStatus {
  ACTIVE
  PAUSED
  CLOSED
}

model Branch {
  id                         String                               @id @default(uuid()) @db.Uuid
  tenant_id                  String                               @db.Uuid
  name                       String                               @db.VarChar
  code                       String                               @db.VarChar
  status                     BranchStatus
  phone                      String?                              @db.VarChar
  address_line               String                               @db.VarChar
  city                       String                               @db.VarChar
  timezone                   String                               @db.VarChar
  location                   Unsupported("geography(Point,4326)")
  min_order_minor            BigInt?
  default_delivery_fee_minor BigInt?
  accepts_delivery           Boolean
  accepts_pickup             Boolean
  preparation_time_minutes   Int?
  created_at                 DateTime                             @default(now()) @db.Timestamptz
  updated_at                 DateTime                             @updatedAt @db.Timestamptz
  deleted_at                 DateTime?                            @db.Timestamptz

  tenant           Tenant                 @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  hours            BranchHour[]
  special_hours    BranchSpecialHour[]
  delivery_zones   DeliveryZone[]
  user_assignments UserBranchAssignment[]
  branch_products  BranchProduct[]
  rider_profiles   RiderProfile[]
  cod_ledgers      CodLedger[]
  promotionRules   PromotionRule[]
  reviews          OrderReview[]

  @@unique([tenant_id, code])
  @@index([location], type: Gist)
  @@index([tenant_id, status])
  @@map("branches")
}

model BranchHour {
  id               String   @id @default(uuid()) @db.Uuid
  tenant_id        String   @db.Uuid
  branch_id        String   @db.Uuid
  day_of_week      Int      @db.SmallInt
  open_time        DateTime @db.Time
  close_time       DateTime @db.Time
  crosses_midnight Boolean
  is_closed        Boolean

  branch Branch @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  @@map("branch_hours")
}

model BranchSpecialHour {
  id         String    @id @default(uuid()) @db.Uuid
  tenant_id  String    @db.Uuid
  branch_id  String    @db.Uuid
  date       DateTime  @db.Date
  open_time  DateTime? @db.Time
  close_time DateTime? @db.Time
  is_closed  Boolean
  reason     String?   @db.VarChar

  branch Branch @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  @@map("branch_special_hours")
}

enum ZoneType {
  RADIUS
  POLYGON
  AREA_CODE
}

model DeliveryZone {
  id                 String                                       @id @default(uuid()) @db.Uuid
  tenant_id          String                                       @db.Uuid
  branch_id          String                                       @db.Uuid
  name               String                                       @db.VarChar
  zone_type          ZoneType
  polygon            Unsupported("geography(MultiPolygon,4326)")?
  radius_meters      Int?
  center             Unsupported("geography(Point,4326)")?
  area_codes         String[]
  delivery_fee_minor BigInt
  min_order_minor    BigInt?
  priority           Int
  active             Boolean

  branch Branch @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  @@map("delivery_zones")
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String?    @db.VarChar
  phone         String?    @db.VarChar
  password_hash String?    @db.VarChar
  display_name  String     @db.VarChar
  status        UserStatus
  created_at    DateTime   @default(now()) @db.Timestamptz
  updated_at    DateTime   @updatedAt @db.Timestamptz

  memberships            TenantMembership[]
  branch_assignments     UserBranchAssignment[]
  rider_profile          RiderProfile?
  delivery_assignments   DeliveryAssignment[]
  cod_ledgers_as_rider   CodLedger[]            @relation("CodRider")
  cod_ledgers_as_settler CodLedger[]            @relation("CodSettler")
  chat_messages          ChatMessage[]
  notification_events    NotificationEvent[]

  @@map("users")
}

enum MembershipStatus {
  ACTIVE
  INVITED
  DISABLED
}

model TenantMembership {
  id         String           @id @default(uuid()) @db.Uuid
  tenant_id  String           @db.Uuid
  user_id    String           @db.Uuid
  status     MembershipStatus
  created_at DateTime         @default(now()) @db.Timestamptz

  tenant Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user   User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  roles  MembershipRole[]

  @@unique([tenant_id, user_id])
  @@map("tenant_memberships")
}

model Role {
  id        String  @id @default(uuid()) @db.Uuid
  tenant_id String? @db.Uuid
  key       String  @db.VarChar
  name      String  @db.VarChar
  is_system Boolean

  tenant      Tenant?          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships MembershipRole[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique @db.VarChar
  description String @db.VarChar

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role_id       String @db.Uuid
  permission_id String @db.Uuid

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

model MembershipRole {
  membership_id String @db.Uuid
  role_id       String @db.Uuid

  membership TenantMembership @relation(fields: [membership_id], references: [id], onDelete: Cascade)
  role       Role             @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([membership_id, role_id])
  @@map("membership_roles")
}

model UserBranchAssignment {
  tenant_id String @db.Uuid
  user_id   String @db.Uuid
  branch_id String @db.Uuid

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  @@id([tenant_id, user_id, branch_id])
  @@map("user_branch_assignments")
}

model Customer {
  id                 String    @id @default(uuid()) @db.Uuid
  tenant_id          String    @db.Uuid
  first_name         String    @db.VarChar
  last_name          String?   @db.VarChar
  email              String?   @db.VarChar
  phone              String?   @db.VarChar
  password_hash      String?   @db.VarChar
  is_verified        Boolean   @default(false)
  is_blocked         Boolean   @default(false)
  blocked_reason     String?   @db.VarChar
  blocked_at         DateTime? @db.Timestamptz
  blocked_by_user_id String?   @db.Uuid
  created_at         DateTime  @default(now()) @db.Timestamptz
  updated_at         DateTime  @updatedAt @db.Timestamptz

  tenant          Tenant                  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  tags            CustomerTagAssignment[]
  favorites       CustomerFavorite[]
  reviews         OrderReview[]
  support_tickets SupportTicket[]
  audit_logs      CustomerAuditLog[]

  @@unique([tenant_id, email])
  @@unique([tenant_id, phone])
  @@map("customers")
}

enum TokenType {
  REFRESH
}

model RefreshSession {
  id          String   @id @default(uuid()) @db.Uuid
  tenant_id   String   @db.Uuid
  user_id     String?  @db.Uuid
  customer_id String?  @db.Uuid
  token_hash  String   @db.VarChar
  expires_at  DateTime @db.Timestamptz
  is_revoked  Boolean  @default(false)
  user_agent  String?  @db.VarChar
  ip_address  String?  @db.VarChar
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @updatedAt @db.Timestamptz

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([token_hash])
  @@index([user_id])
  @@index([customer_id])
  @@map("refresh_sessions")
}

model OtpChallenge {
  id          String   @id @default(uuid()) @db.Uuid
  tenant_id   String   @db.Uuid
  identifier  String   @db.VarChar // phone or email
  otp_hash    String   @db.VarChar
  attempts    Int      @default(0) @db.SmallInt
  expires_at  DateTime @db.Timestamptz
  is_verified Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, identifier])
  @@map("otp_challenges")
}

// ─── Catalog ─────────────────────────────────────────────────────────────────

enum CatalogStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Category {
  id              String        @id @default(uuid()) @db.Uuid
  tenant_id       String        @db.Uuid
  parent_id       String?       @db.Uuid
  name            String        @db.VarChar
  slug            String        @db.VarChar
  description     String?       @db.Text
  image_url       String?       @db.VarChar
  sort_order      Int           @default(0)
  status          CatalogStatus @default(DRAFT)
  available_from  DateTime?     @db.Timestamptz
  available_until DateTime?     @db.Timestamptz
  created_at      DateTime      @default(now()) @db.Timestamptz
  updated_at      DateTime      @updatedAt @db.Timestamptz
  deleted_at      DateTime?     @db.Timestamptz

  tenant   Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryChildren", fields: [parent_id], references: [id])
  children Category[] @relation("CategoryChildren")
  products Product[]

  @@unique([tenant_id, slug])
  @@index([tenant_id, status])
  @@map("categories")
}

model Product {
  id                       String        @id @default(uuid()) @db.Uuid
  tenant_id                String        @db.Uuid
  category_id              String        @db.Uuid
  name                     String        @db.VarChar
  slug                     String        @db.VarChar
  description              String?       @db.Text
  base_price_minor         BigInt
  currency_code            String        @db.Char(3)
  status                   CatalogStatus @default(DRAFT)
  preparation_time_minutes Int?
  featured                 Boolean       @default(false)
  metadata_json            Json?
  created_at               DateTime      @default(now()) @db.Timestamptz
  updated_at               DateTime      @updatedAt @db.Timestamptz
  deleted_at               DateTime?     @db.Timestamptz

  tenant           Tenant                 @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  category         Category               @relation(fields: [category_id], references: [id])
  media            ProductMedia[]
  branch_overrides BranchProduct[]
  variants         ProductVariant[]
  modifier_groups  ProductModifierGroup[]
  cartItems        CartItem[]
  favorites        CustomerFavorite[]

  @@unique([tenant_id, slug])
  @@index([tenant_id, status, category_id])
  @@index([tenant_id, featured])
  @@map("products")
}

model ProductMedia {
  id         String   @id @default(uuid()) @db.Uuid
  tenant_id  String   @db.Uuid
  product_id String   @db.Uuid
  media_url  String   @db.VarChar
  alt_text   String?  @db.VarChar
  sort_order Int      @default(0)
  is_primary Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id, sort_order])
  @@map("product_media")
}

model BranchProduct {
  tenant_id                 String    @db.Uuid
  branch_id                 String    @db.Uuid
  product_id                String    @db.Uuid
  enabled                   Boolean   @default(true)
  sold_out                  Boolean   @default(false)
  price_override_minor      BigInt?
  preparation_time_override Int?
  available_from            DateTime? @db.Timestamptz
  available_until           DateTime? @db.Timestamptz

  branch  Branch  @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@id([tenant_id, branch_id, product_id])
  @@index([tenant_id, branch_id, enabled])
  @@map("branch_products")
}

// ─── Variants & Modifiers ─────────────────────────────────────────────────────

enum VariantStatus {
  ACTIVE
  INACTIVE
}

model ProductVariant {
  id          String        @id @default(uuid()) @db.Uuid
  tenant_id   String        @db.Uuid
  product_id  String        @db.Uuid
  name        String        @db.VarChar
  sku         String?       @db.VarChar
  price_minor BigInt
  status      VariantStatus @default(ACTIVE)
  sort_order  Int           @default(0)
  created_at  DateTime      @default(now()) @db.Timestamptz
  updated_at  DateTime      @updatedAt @db.Timestamptz

  product   Product    @relation(fields: [product_id], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  @@index([tenant_id, product_id, status])
  @@map("product_variants")
}

model ModifierGroup {
  id         String        @id @default(uuid()) @db.Uuid
  tenant_id  String        @db.Uuid
  name       String        @db.VarChar
  min_select Int           @default(0)
  max_select Int           @default(1)
  required   Boolean       @default(false)
  status     VariantStatus @default(ACTIVE)
  created_at DateTime      @default(now()) @db.Timestamptz
  updated_at DateTime      @updatedAt @db.Timestamptz

  tenant    Tenant                 @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  modifiers Modifier[]
  products  ProductModifierGroup[]

  @@index([tenant_id, status])
  @@map("modifier_groups")
}

model Modifier {
  id                String        @id @default(uuid()) @db.Uuid
  tenant_id         String        @db.Uuid
  modifier_group_id String        @db.Uuid
  name              String        @db.VarChar
  price_delta_minor BigInt        @default(0)
  status            VariantStatus @default(ACTIVE)
  sort_order        Int           @default(0)
  created_at        DateTime      @default(now()) @db.Timestamptz
  updated_at        DateTime      @updatedAt @db.Timestamptz

  group             ModifierGroup      @relation(fields: [modifier_group_id], references: [id], onDelete: Cascade)
  cartItemModifiers CartItemModifier[]

  @@index([tenant_id, modifier_group_id, status])
  @@map("modifiers")
}

model ProductModifierGroup {
  tenant_id         String @db.Uuid
  product_id        String @db.Uuid
  modifier_group_id String @db.Uuid
  sort_order        Int    @default(0)

  product        Product       @relation(fields: [product_id], references: [id], onDelete: Cascade)
  modifier_group ModifierGroup @relation(fields: [modifier_group_id], references: [id], onDelete: Cascade)

  @@id([tenant_id, product_id, modifier_group_id])
  @@map("product_modifier_groups")
}

// ─── Cart ─────────────────────────────────────────────────────────────────────

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum FulfillmentMethod {
  DELIVERY
  PICKUP
}

model Cart {
  id                 String            @id @default(uuid()) @db.Uuid
  tenant_id          String            @db.Uuid
  customer_id        String?           @db.Uuid
  guest_token        String?           @db.VarChar
  branch_id          String?           @db.Uuid
  fulfillment_method FulfillmentMethod @default(DELIVERY)
  status             CartStatus        @default(ACTIVE)
  expires_at         DateTime          @db.Timestamptz
  created_at         DateTime          @default(now()) @db.Timestamptz
  updated_at         DateTime          @updatedAt @db.Timestamptz

  items CartItem[]

  @@unique([tenant_id, guest_token])
  @@index([tenant_id, customer_id, status])
  @@index([tenant_id, guest_token, status])
  @@map("carts")
}

model CartItem {
  id         String   @id @default(uuid()) @db.Uuid
  cart_id    String   @db.Uuid
  product_id String   @db.Uuid
  variant_id String?  @db.Uuid
  quantity   Int      @default(1)
  notes      String?  @db.VarChar
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  cart      Cart               @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  product   Product            @relation(fields: [product_id], references: [id])
  variant   ProductVariant?    @relation(fields: [variant_id], references: [id])
  modifiers CartItemModifier[]

  @@index([cart_id])
  @@map("cart_items")
}

model CartItemModifier {
  id           String @id @default(uuid()) @db.Uuid
  cart_item_id String @db.Uuid
  modifier_id  String @db.Uuid

  cart_item CartItem @relation(fields: [cart_item_id], references: [id], onDelete: Cascade)
  modifier  Modifier @relation(fields: [modifier_id], references: [id])

  @@index([cart_item_id])
  @@map("cart_item_modifiers")
}

// ─── Idempotency ──────────────────────────────────────────────────────────────

model IdempotencyKey {
  id              String   @id @default(uuid()) @db.Uuid
  tenant_id       String   @db.Uuid
  actor_scope     String   @db.VarChar
  operation       String   @db.VarChar
  idempotency_key String   @db.VarChar
  response_body   Json?    @db.JsonB
  status          String   @default("IN_PROGRESS") @db.VarChar
  created_at      DateTime @default(now()) @db.Timestamptz
  updated_at      DateTime @updatedAt @db.Timestamptz

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, actor_scope, operation, idempotency_key])
  @@index([created_at])
  @@map("idempotency_keys")
}

// ─── Orders ──────────────────────────────────────────────────────────────────

enum OrderChannel {
  WEB
  MOBILE
  POS
  ADMIN
  QR
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PREPARING
  READY
  RIDER_ASSIGNED
  PICKED_UP
  ON_THE_WAY
  DELIVERED
  REJECTED
  CANCELLED
  FAILED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

model Order {
  id                        String                                @id @default(uuid()) @db.Uuid
  tenant_id                 String                                @db.Uuid
  branch_id                 String                                @db.Uuid
  customer_id               String?                               @db.Uuid
  order_number              String                                @db.VarChar
  channel                   OrderChannel
  fulfillment_type          FulfillmentMethod
  status                    OrderStatus                           @default(PLACED)
  payment_status            PaymentStatus                         @default(PENDING)
  currency_code             String                                @db.Char(3)
  subtotal_minor            BigInt
  item_discount_minor       BigInt                                @default(0)
  promotion_discount_minor  BigInt                                @default(0)
  coupon_discount_minor     BigInt                                @default(0)
  delivery_fee_minor        BigInt                                @default(0)
  service_fee_minor         BigInt                                @default(0)
  tax_minor                 BigInt                                @default(0)
  tip_minor                 BigInt                                @default(0)
  wallet_credit_minor       BigInt                                @default(0)
  grand_total_minor         BigInt
  paid_minor                BigInt                                @default(0)
  refunded_minor            BigInt                                @default(0)
  customer_name_snapshot    String                                @db.VarChar
  customer_phone_snapshot   String                                @db.VarChar
  delivery_address_snapshot Json?                                 @db.JsonB
  delivery_location         Unsupported("geography(Point,4326)")?
  customer_note             String?                               @db.Text
  scheduled_for             DateTime?                             @db.Timestamptz
  placed_at                 DateTime                              @db.Timestamptz
  confirmed_at              DateTime?                             @db.Timestamptz
  ready_at                  DateTime?                             @db.Timestamptz
  delivered_at              DateTime?                             @db.Timestamptz
  cancelled_at              DateTime?                             @db.Timestamptz
  created_at                DateTime                              @default(now()) @db.Timestamptz
  updated_at                DateTime                              @updatedAt @db.Timestamptz

  items               OrderItem[]
  history             OrderStatusHistory[]
  delivery_assignment DeliveryAssignment?
  chat_threads        ChatThread[]
  notification_events NotificationEvent[]
  orderPromotions     OrderPromotion[]
  review              OrderReview?
  support_tickets     SupportTicket[]

  @@unique([tenant_id, order_number])
  @@index([tenant_id, branch_id, status, created_at(sort: Desc)])
  @@index([tenant_id, customer_id, created_at(sort: Desc)])
  @@index([tenant_id, payment_status, created_at(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id                   String  @id @default(uuid()) @db.Uuid
  tenant_id            String  @db.Uuid
  order_id             String  @db.Uuid
  product_id           String? @db.Uuid
  variant_id           String? @db.Uuid
  product_name         String  @db.VarChar
  variant_name         String? @db.VarChar
  unit_price_minor     BigInt
  quantity             Int
  line_subtotal_minor  BigInt
  line_discount_minor  BigInt  @default(0)
  line_tax_minor       BigInt  @default(0)
  line_total_minor     BigInt
  special_instructions String? @db.Text
  metadata_snapshot    Json?   @db.JsonB

  order     Order               @relation(fields: [order_id], references: [id], onDelete: Cascade)
  modifiers OrderItemModifier[]

  @@index([order_id])
  @@map("order_items")
}

model OrderItemModifier {
  id                     String  @id @default(uuid()) @db.Uuid
  tenant_id              String  @db.Uuid
  order_item_id          String  @db.Uuid
  modifier_id            String? @db.Uuid
  modifier_name          String  @db.VarChar
  unit_price_delta_minor BigInt
  quantity               Int
  total_minor            BigInt

  order_item OrderItem @relation(fields: [order_item_id], references: [id], onDelete: Cascade)

  @@index([order_item_id])
  @@map("order_item_modifiers")
}

enum ActorType {
  CUSTOMER
  STAFF
  RIDER
  SYSTEM
}

model OrderStatusHistory {
  id          String       @id @default(uuid()) @db.Uuid
  tenant_id   String       @db.Uuid
  order_id    String       @db.Uuid
  from_status OrderStatus?
  to_status   OrderStatus
  actor_type  ActorType
  actor_id    String?      @db.Uuid
  reason_code String?      @db.VarChar
  reason_text String?      @db.Text
  source      String       @db.VarChar
  created_at  DateTime     @default(now()) @db.Timestamptz

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@map("order_status_history")
}

// ─── Payments ────────────────────────────────────────────────────────────────

model Payment {
  id                  String        @id @default(uuid()) @db.Uuid
  tenant_id           String        @db.Uuid
  order_id            String        @db.Uuid
  provider            String        @db.VarChar
  method              String        @db.VarChar
  status              PaymentStatus @default(PENDING)
  amount_minor        BigInt
  currency_code       String        @db.Char(3)
  provider_payment_id String?       @db.VarChar
  paid_at             DateTime?     @db.Timestamptz
  created_at          DateTime      @default(now()) @db.Timestamptz
  updated_at          DateTime      @updatedAt @db.Timestamptz

  attempts PaymentAttempt[]
  refunds  Refund[]

  @@index([tenant_id, order_id])
  @@map("payments")
}

model PaymentAttempt {
  id                  String   @id @default(uuid()) @db.Uuid
  tenant_id           String   @db.Uuid
  payment_id          String   @db.Uuid
  provider_attempt_id String?  @db.VarChar
  status              String   @db.VarChar
  amount_minor        BigInt
  request_metadata    Json?    @db.JsonB
  response_metadata   Json?    @db.JsonB
  created_at          DateTime @default(now()) @db.Timestamptz

  payment Payment @relation(fields: [payment_id], references: [id], onDelete: Cascade)

  @@index([payment_id])
  @@map("payment_attempts")
}

enum WebhookProcessingStatus {
  PENDING
  PROCESSED
  FAILED
  IGNORED
}

model PaymentWebhookEvent {
  id                String                  @id @default(uuid()) @db.Uuid
  provider          String                  @db.VarChar
  provider_event_id String                  @db.VarChar
  tenant_id         String?                 @db.Uuid
  event_type        String                  @db.VarChar
  payload_redacted  Json?                   @db.JsonB
  received_at       DateTime                @default(now()) @db.Timestamptz
  processed_at      DateTime?               @db.Timestamptz
  processing_status WebhookProcessingStatus @default(PENDING)

  @@unique([provider, provider_event_id])
  @@map("payment_webhook_events")
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Refund {
  id                 String       @id @default(uuid()) @db.Uuid
  tenant_id          String       @db.Uuid
  payment_id         String       @db.Uuid
  order_id           String       @db.Uuid
  amount_minor       BigInt
  reason_code        String       @db.VarChar
  reason_text        String?      @db.Text
  status             RefundStatus @default(PENDING)
  provider_refund_id String?      @db.VarChar
  initiated_by       String?      @db.Uuid
  created_at         DateTime     @default(now()) @db.Timestamptz
  completed_at       DateTime?    @db.Timestamptz

  payment Payment @relation(fields: [payment_id], references: [id], onDelete: Cascade)

  @@index([payment_id])
  @@map("refunds")
}

// ─── Realtime & Outbox ───────────────────────────────────────────────────────

enum OutboxEventStatus {
  PENDING
  PROCESSED
  FAILED
}

model OutboxEvent {
  id             String            @id @default(uuid()) @db.Uuid
  tenant_id      String            @db.Uuid
  aggregate_type String            @db.VarChar
  aggregate_id   String            @db.VarChar
  event_type     String            @db.VarChar
  payload        Json              @db.JsonB
  status         OutboxEventStatus @default(PENDING)
  error          String?           @db.Text
  created_at     DateTime          @default(now()) @db.Timestamptz
  processed_at   DateTime?         @db.Timestamptz

  @@index([status, created_at(sort: Asc)])
  @@index([tenant_id])
  @@map("outbox_events")
}

// ─── Riders & Delivery ────────────────────────────────────────────────────────

enum RiderStatus {
  OFFLINE
  AVAILABLE
  ON_DELIVERY
}

model RiderProfile {
  user_id             String                                @id @db.Uuid
  tenant_id           String                                @db.Uuid
  current_branch_id   String?                               @db.Uuid
  status              RiderStatus                           @default(OFFLINE)
  vehicle_type        String?                               @db.VarChar
  vehicle_plate       String?                               @db.VarChar
  last_location       Unsupported("geography(Point,4326)")?
  location_updated_at DateTime?                             @db.Timestamptz
  created_at          DateTime                              @default(now()) @db.Timestamptz
  updated_at          DateTime                              @updatedAt @db.Timestamptz

  user   User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [current_branch_id], references: [id])

  @@index([tenant_id, current_branch_id, status])
  @@map("rider_profiles")
}

enum DeliveryState {
  ASSIGNED
  ACCEPTED
  AT_STORE
  PICKED_UP
  ON_THE_WAY
  ARRIVED
  DELIVERED
  CANCELLED
}

model DeliveryAssignment {
  id                String        @id @default(uuid()) @db.Uuid
  tenant_id         String        @db.Uuid
  order_id          String        @unique @db.Uuid
  rider_id          String        @db.Uuid
  state             DeliveryState @default(ASSIGNED)
  assigned_at       DateTime      @default(now()) @db.Timestamptz
  accepted_at       DateTime?     @db.Timestamptz
  picked_up_at      DateTime?     @db.Timestamptz
  delivered_at      DateTime?     @db.Timestamptz
  notes             String?       @db.Text
  delivery_otp_hash String?       @db.VarChar

  order                Order                 @relation(fields: [order_id], references: [id], onDelete: Cascade)
  rider                User                  @relation(fields: [rider_id], references: [id], onDelete: Cascade)
  deliveryLocationLogs DeliveryLocationLog[]

  @@index([tenant_id, rider_id, state])
  @@map("delivery_assignments")
}

model DeliveryLocationLog {
  id            String                               @id @default(uuid()) @db.Uuid
  assignment_id String                               @db.Uuid
  location      Unsupported("geography(Point,4326)")
  accuracy      Float?
  heading       Float?
  speed         Float?
  logged_at     DateTime                             @default(now()) @db.Timestamptz

  assignment DeliveryAssignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)

  @@index([assignment_id, logged_at(sort: Desc)])
  @@map("delivery_location_logs")
}

enum CodLedgerType {
  COLLECTED
  SETTLED
}

model CodLedger {
  id            String        @id @default(uuid()) @db.Uuid
  tenant_id     String        @db.Uuid
  rider_id      String        @db.Uuid
  branch_id     String        @db.Uuid
  order_id      String?       @db.Uuid
  type          CodLedgerType
  amount_minor  BigInt
  reference     String?       @db.VarChar
  created_at    DateTime      @default(now()) @db.Timestamptz
  settled_by_id String?       @db.Uuid

  rider   User   @relation("CodRider", fields: [rider_id], references: [id])
  branch  Branch @relation(fields: [branch_id], references: [id])
  settler User?  @relation("CodSettler", fields: [settled_by_id], references: [id])

  @@index([tenant_id, rider_id, created_at(sort: Desc)])
  @@map("cod_ledgers")
}

// ─── Chat & Notifications ─────────────────────────────────────────────────────

enum ChatThreadStatus {
  OPEN
  CLOSED
}

model ChatThread {
  id         String           @id @default(uuid()) @db.Uuid
  tenant_id  String           @db.Uuid
  order_id   String           @db.Uuid
  status     ChatThreadStatus @default(OPEN)
  created_at DateTime         @default(now()) @db.Timestamptz
  updated_at DateTime         @updatedAt @db.Timestamptz

  order    Order         @relation(fields: [order_id], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([tenant_id, order_id])
  @@map("chat_threads")
}

model ChatMessage {
  id         String    @id @default(uuid()) @db.Uuid
  thread_id  String    @db.Uuid
  sender_id  String    @db.Uuid
  content    String    @db.Text
  created_at DateTime  @default(now()) @db.Timestamptz
  read_at    DateTime? @db.Timestamptz

  thread ChatThread @relation(fields: [thread_id], references: [id], onDelete: Cascade)
  sender User       @relation(fields: [sender_id], references: [id], onDelete: Cascade)

  @@index([thread_id, created_at(sort: Asc)])
  @@map("chat_messages")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model NotificationEvent {
  id              String             @id @default(uuid()) @db.Uuid
  tenant_id       String             @db.Uuid
  user_id         String?            @db.Uuid
  order_id        String?            @db.Uuid
  channel         String             @db.VarChar // EMAIL, SMS, PUSH
  template_name   String             @db.VarChar
  payload         Json?              @db.JsonB
  status          NotificationStatus @default(PENDING)
  error_message   String?            @db.Text
  idempotency_key String?            @unique @db.VarChar
  created_at      DateTime           @default(now()) @db.Timestamptz
  sent_at         DateTime?          @db.Timestamptz

  user  User?  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, user_id, created_at(sort: Desc)])
  @@index([idempotency_key])
  @@map("notification_events")
}

// ─── Promotions & CMS ────────────────────────────────────────────────────────

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_DELIVERY
}

enum PromotionStatus {
  ACTIVE
  INACTIVE
}

model Promotion {
  id               String          @id @default(uuid()) @db.Uuid
  tenant_id        String          @db.Uuid
  code             String          @db.VarChar // e.g. "SUMMER20"
  type             PromotionType
  value            BigInt // Percentage (e.g. 2000 = 20%) or minor units for FIXED
  status           PromotionStatus @default(ACTIVE)
  start_date       DateTime?       @db.Timestamptz
  end_date         DateTime?       @db.Timestamptz
  usage_limit      Int? // e.g. only 100 uses total
  current_usage    Int             @default(0)
  min_order_amount BigInt?
  created_at       DateTime        @default(now()) @db.Timestamptz
  updated_at       DateTime        @updatedAt @db.Timestamptz

  rules            PromotionRule[]
  order_promotions OrderPromotion[]

  @@unique([tenant_id, code])
  @@index([tenant_id, status])
  @@map("promotions")
}

model PromotionRule {
  id           String   @id @default(uuid()) @db.Uuid
  promotion_id String   @db.Uuid
  branch_id    String?  @db.Uuid // If restricted to a branch
  category_id  String?  @db.Uuid // If restricted to a category
  product_id   String?  @db.Uuid // If restricted to a specific product
  created_at   DateTime @default(now()) @db.Timestamptz

  promotion Promotion @relation(fields: [promotion_id], references: [id], onDelete: Cascade)
  branch    Branch?   @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  @@index([promotion_id])
  @@map("promotion_rules")
}

model OrderPromotion {
  id             String   @id @default(uuid()) @db.Uuid
  order_id       String   @db.Uuid
  promotion_id   String   @db.Uuid
  discount_minor BigInt // Exact amount discounted
  applied_at     DateTime @default(now()) @db.Timestamptz

  order     Order     @relation(fields: [order_id], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotion_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@index([promotion_id])
  @@map("order_promotions")
}

model Banner {
  id         String    @id @default(uuid()) @db.Uuid
  tenant_id  String    @db.Uuid
  title      String    @db.VarChar
  image_url  String    @db.VarChar
  target_url String?   @db.VarChar
  is_active  Boolean   @default(true)
  sort_order Int       @default(0)
  start_date DateTime? @db.Timestamptz
  end_date   DateTime? @db.Timestamptz
  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz

  @@index([tenant_id, is_active])
  @@map("banners")
}

// ─── CRM, Reviews & Support ──────────────────────────────────────────────────

model CustomerTag {
  id         String   @id @default(uuid()) @db.Uuid
  tenant_id  String   @db.Uuid
  name       String   @db.VarChar
  color      String?  @db.VarChar
  created_at DateTime @default(now()) @db.Timestamptz

  assignments CustomerTagAssignment[]

  @@unique([tenant_id, name])
  @@index([tenant_id])
  @@map("customer_tags")
}

model CustomerTagAssignment {
  id          String   @id @default(uuid()) @db.Uuid
  tag_id      String   @db.Uuid
  customer_id String   @db.Uuid
  assigned_at DateTime @default(now()) @db.Timestamptz

  tag      CustomerTag @relation(fields: [tag_id], references: [id], onDelete: Cascade)
  customer Customer    @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@unique([tag_id, customer_id])
  @@index([customer_id])
  @@map("customer_tag_assignments")
}

model CustomerFavorite {
  id          String   @id @default(uuid()) @db.Uuid
  tenant_id   String   @db.Uuid
  customer_id String   @db.Uuid
  product_id  String   @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz

  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([customer_id, product_id])
  @@index([tenant_id, customer_id])
  @@map("customer_favorites")
}

model OrderReview {
  id           String   @id @default(uuid()) @db.Uuid
  tenant_id    String   @db.Uuid
  order_id     String   @unique @db.Uuid
  customer_id  String   @db.Uuid
  branch_id    String   @db.Uuid
  food_rating  Int      @db.SmallInt
  rider_rating Int?     @db.SmallInt
  comment      String?  @db.Text
  created_at   DateTime @default(now()) @db.Timestamptz
  updated_at   DateTime @updatedAt @db.Timestamptz

  order    Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, branch_id])
  @@index([tenant_id, customer_id])
  @@map("order_reviews")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketSenderType {
  CUSTOMER
  STAFF
}

model SupportTicket {
  id          String         @id @default(uuid()) @db.Uuid
  tenant_id   String         @db.Uuid
  customer_id String         @db.Uuid
  order_id    String?        @db.Uuid
  subject     String         @db.VarChar
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(NORMAL)
  created_at  DateTime       @default(now()) @db.Timestamptz
  updated_at  DateTime       @updatedAt @db.Timestamptz

  customer Customer               @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  order    Order?                 @relation(fields: [order_id], references: [id], onDelete: SetNull)
  messages SupportTicketMessage[]

  @@index([tenant_id, status])
  @@index([tenant_id, customer_id])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id          String           @id @default(uuid()) @db.Uuid
  ticket_id   String           @db.Uuid
  sender_type TicketSenderType
  sender_id   String           @db.Uuid
  message     String           @db.Text
  created_at  DateTime         @default(now()) @db.Timestamptz

  ticket SupportTicket @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  @@index([ticket_id, created_at])
  @@map("support_ticket_messages")
}

enum CustomerAuditAction {
  BLOCK
  UNBLOCK
  VIEW_PII
  UPDATE_METADATA
}

model CustomerAuditLog {
  id          String              @id @default(uuid()) @db.Uuid
  tenant_id   String              @db.Uuid
  customer_id String              @db.Uuid
  actor_id    String              @db.Uuid
  action      CustomerAuditAction
  reason      String?             @db.VarChar
  metadata    Json?               @db.JsonB
  created_at  DateTime            @default(now()) @db.Timestamptz

  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, customer_id, created_at(sort: Desc)])
  @@map("customer_audit_logs")
}

// ─── Reporting & Operational Audit ───────────────────────────────────────────

model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  tenant_id   String    @db.Uuid
  actor_id    String    @db.Uuid
  actor_type  ActorType @default(STAFF)
  action      String    @db.VarChar
  entity_type String    @db.VarChar
  entity_id   String    @db.VarChar
  details     Json?     @db.JsonB
  ip_address  String?   @db.VarChar
  user_agent  String?   @db.VarChar
  created_at  DateTime  @default(now()) @db.Timestamptz

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, created_at(sort: Desc)])
  @@index([tenant_id, entity_type, entity_id])
  @@index([tenant_id, actor_id])
  @@map("audit_logs")
}
