{
  "expo": {
    "name": "Restaurant Rider App",
    "slug": "restaurant-rider-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.restaurant.rider",
      "infoPlist": {
        "NSLocationAlwaysAndWhenInUseUsageDescription": "We use your location in the background to track deliveries in progress.",
        "NSLocationWhenInUseUsageDescription": "We use your location to track deliveries.",
        "UIBackgroundModes": ["location", "fetch", "remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.restaurant.rider",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "This app uses your location in the background to track active deliveries."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#e8453c"
        }
      ]
    ],
    "scheme": "restaurant-rider",
    "extra": {
      "apiUrl": "https://api.yourrestaurant.com",
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    }
  }
}
